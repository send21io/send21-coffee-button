# ☕ send21-coffee-button. Leave SEND21_API_KEY empty for mock mode (no account, no money).

# send21 API key (scope drafts:write; add webhooks:manage for npm run webhook:register)
SEND21_API_KEY=
# Shown once when the webhook is created (npm run webhook:register or the send21 web app)
SEND21_WEBHOOK_SECRET=

# Your public https:// address (pay links and webhooks point here)
PUBLIC_URL=https://coffee.example.com
PORT=3000
# 1 if you run behind a reverse proxy (for per-IP rate limits)
TRUST_PROXY=0

# Who gets the coffee (plain text, max 32)
CREATOR_NAME=tiny-lib
# Price of one coffee, in fiat. Fans pick ×1, ×3 or ×5.
COFFEE_PRICE=3
COFFEE_CURRENCY=EUR

# ⚡ The hero: your Lightning address. Use a wallet with LUD-21 so payments confirm on their own.
PAY_LIGHTNING=you@your-wallet.com
# Optional extras, coin:address, comma separated. Coins:
# btc, usdc-sol, usdc-eth, usdc-base, usdc-arb, usdc-pol, usdt-sol, usdt-eth,
# eurc-sol, eurc-eth, eurc-base, sol, eth-eth, eth-base, eth-arb
PAY_OPTIONS=usdc-sol:<your solana address>

# Pay link lifetime and how much short-pay you absorb (percent)
COFFEE_EXPIRY_HOURS=24
COFFEE_SHORTFALL_PERCENT=2

# 🎉 Wall: show amounts? show messages?
WALL_SHOW_AMOUNTS=false
WALL_SHOW_MESSAGES=true
# 🔎 Wall: show each on-chain payment's txId with a block explorer link (solscan, etherscan,
# mempool.space) and your on-chain receiving addresses, so anyone can check the wall. Lightning: never linked.
WALL_SHOW_TX=true

DATA_FILE=./data/coffee.json
